{
  "label": "COUNTERFACTUAL -- an accounting exercise with stated assumptions, not a forecast",
  "inputs": [
    "data/sources/worldbank_annual_multi.csv",
    "data/sources/worldbank_annual.csv",
    "data/sources/wb_inflation_monthly.csv",
    "data/sources/tgju_monthly.csv",
    "results/model/rolling_passthrough.csv"
  ],
  "assumptions": {
    "non_oil_exports_usd_bn": {
      "value": 49.0,
      "range": [
        40.0,
        55.0
      ],
      "source": "IRICA customs statistics, non-oil exports 1402 (~USD 49 bn)"
    },
    "essentials_markup_over_food": {
      "value": 0.35,
      "source": "medicine and agricultural inputs added on top of the food import bill, per trade-composition reports"
    },
    "services_import_share": {
      "value": 0.18,
      "range": [
        0.12,
        0.25
      ],
      "source": "services imports on top of the customs goods bill, per pre-sanctions balance-of-payments composition"
    },
    "capital_outflow_usd_bn": {
      "value": 15.0,
      "range": [
        10.0,
        20.0
      ],
      "source": "central-bank and press estimates of annual capital flight, 1397-1403 (~USD 10-20 bn/yr); FX demand the market must clear on top of imports"
    },
    "usd_inflation_factor_since_2010": {
      "value": 1.4,
      "range": [
        1.3,
        1.5
      ],
      "source": "US CPI averaged ~2.4%/yr 2010-2025; converts the 2010 import norm into today's dollars"
    },
    "export_capacity_mbpd": {
      "value": 2.5,
      "source": "pre-2018 peak crude+condensate exports (~2.5 mbpd, 1396)"
    },
    "investment_window_jalali": {
      "value": [
        1397,
        1403
      ],
      "source": "the post-2018 sanctions regime, matching the inflation regime break estimated in results/growth_regimes.json"
    }
  },
  "thresholds": {
    "floor_usd_bn": {
      "value": 23.379119565649336,
      "detail": "food 29.5% of merchandise imports (58.8 bn, 2022) x (1 + essentials markup)"
    },
    "stability_usd_bn": {
      "value": 43.44576000000001,
      "detail": "customs imports 65.6 bn (2025) x (1 + services) + capital outflow 15 bn - non-oil exports 49 bn"
    },
    "recovery_usd_bn": {
      "value": 79.97677973356122,
      "detail": "2010 imports (65.4 bn) x 1.4 dollar inflation x 1.19 population growth x (1 + services) = 129 bn, minus non-oil exports"
    }
  },
  "grid": [
    {
      "price_usd": 50.0,
      "discount": 0.05,
      "floor_q_mbpd": 1.3484712078240426,
